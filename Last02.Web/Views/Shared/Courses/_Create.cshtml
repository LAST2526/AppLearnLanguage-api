@model Last02.Models.Dtos.CourseCreateDto
@using Last02.Commons.Extensions

<form id="courseCreateForm" novalidate>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" required maxlength="200"
                   aria-describedby="titleInvalidFeedback">
            <div class="invalid-feedback" id="titleInvalidFeedback"></div>
        </div>
    </div>
    <input type="hidden" name="Id">
    <input type="hidden" name="SelectedLanguages" id="selectedLanguages">
</form>