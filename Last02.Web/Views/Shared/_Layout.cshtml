<!doctype html>
<html lang="en">
        @using Last02.Web.Resources

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - @Resource.ViewBag_Title_AdminDashboard</title>
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="Themesbrand" name="author" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon2.ico">

    <!-- App Css-->
    @RenderSection("styles", required: false)
    <link href="~/css/topbar.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/app.min.css" id="app-light" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/loading.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" id="bootstrap-light" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/data-tables/datatables.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/courses.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/spin/spin.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/fontawesome/all.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/css/book.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/ckeditor5/ckeditor5.css" rel="stylesheet" />
</head>

<body data-sidebar="dark">
    <!-- Loader -->
    <div id="preloader">
        <div id="status">
            <div class="spinner-chase">
                <div class="chase-dot"></div>
                <div class="chase-dot"></div>
                <div class="chase-dot"></div>
            </div>
        </div>
    </div>

    <div id="layout-wrapper">
        @await Html.PartialAsync("~/Views/Shared/_topbar.cshtml")
        @await Html.PartialAsync("~/Views/Shared/_sidebar.cshtml")
        <div class="main-content">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/metismenu/metisMenu.min.js"></script>
    <script src="~/lib/simplebar/simplebar.min.js"></script>
    <script src="~/lib/node-waves/waves.min.js"></script>
    <script src="~/lib/data-tables/datatables.min.js"></script>

    <script src="~/lib/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="~/assets/js/app.js?@DateTime.Now.Ticks"></script>
    <script src="~/assets/js/pages/authentication.init.js?@DateTime.Now.Ticks"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/courses.js" type="module"></script>
    <script src="~/lib/fontawesome/all.min.js"></script>
    <script src="~/js/flash_card_history.js" type="module"></script>
    <script src="~/js/book.js" type="module"></script>
    <script src="~/js/audio_gen_history.js" type="module"></script>
    @RenderSection("scripts", required: false)

    <div id="loader" style="display:none;"></div>
    <style>
    </style>
</body>
</html>