@model IEnumerable<Last02.Data.Entities.FlashcardUpdateHistory>

@{
    ViewData["Title"] = "Flash card History";
}
<div class="page-content">
    <div class="w-100 pt-3 pb-3">
        <button type="button" class="btn btn-primary btn-sm" id="flashcardHistoryCreateBtn">
            <i class="fa-solid fa-file-arrow-up"></i>
            Upload Flashcards
        </button>
    </div>
    <div class="border border-secondary p-2 pb-3 rounded">
        <table id="flashcardHistoryTable" class="table table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th class="text-center text-nowrap">
                        CourseTitle
                    </th>
                    <th class="text-center text-nowrap">
                        CreatedDate
                    </th>
                    <th class="text-center text-nowrap">
                        FileName
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="flashcardHistoryModal" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true"
     tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Flashcard History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("~/Views/Shared/FlashcardHistory/_Create.cshtml")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary course-btn-width" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary course-btn-width" id="flashcardFormSubmitBtn">Save</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="flashcardMessageModal" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true"
     tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary course-btn-width" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="flashcardConfirmModal" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitle">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center" id="confirmModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-action="proceed-download">ダウンロード</button>
            </div>
        </div>
    </div>
</div>