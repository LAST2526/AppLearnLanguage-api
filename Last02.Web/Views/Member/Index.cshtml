@using Last02.Web.Resources
@{
    ViewData["Title"] = "Members";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-content">
    <div class="d-flex justify-content-end w-100 pt-3 pb-3">
        <button id="btnExport" class="btn btn-primary rounded-sm font-15 weight-600">
            <i class="fa-regular fa-circle-down"></i>Download CSV
        </button>
    </div>
    <div class="border border-secondary p-2 pb-3 rounded">
        <table id="memberTable" class="table table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th class="text-center member-td-max-width text-wrap">
                        User ID
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Full Name
                    </th>

                    <th class="text-center member-td-max-width text-wrap">
                        Email Address
                    </th>

                    <th class="text-center member-td-max-width text-wrap">
                        Gender
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Date of Birth
                    </th>

                    <th class="text-center member-td-max-width text-wrap">
                        Nationality
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Selected Course
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Created At
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Updated At
                    </th>
                    <th class="text-center member-td-max-width text-wrap">
                        Active
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="memberDeleteConfirmModal" data-bs-backdrop="static" data-bs-keyboard="false"
     aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="memberDeleteConfirmTitle">Confirm Delete</h5>
                <button type="button" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="memberDeleteConfirmMessage" class="text-center">Are you sure you want to delete?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary member-btn-width" data-bs-toggle="modal"
                        data-bs-target="#memberDeleteConfirmModal">
                    Close
                </button>
                <button type="button" class="btn btn-danger member-btn-width" id="memberDeleteConfirmBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="member-modal-confirm" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="member-modal-confirm-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="member-modal-confirm-body"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary member-modal-button-width" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary member-modal-button-width" id="member-modal-confirm-ok">OK</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/member.js" type="module"></script>
}
